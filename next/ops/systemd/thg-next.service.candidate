# CANDIDATE systemd unit — NOT installed in FND-001. Owned by FND-010.
# Standalone Next server (output: "standalone"): node .next/standalone/server.js
[Unit]
Description=THG Public Web (Next standalone) — CANDIDATE, non-production
After=network.target

[Service]
Type=simple
# Run as a dedicated UNPRIVILEGED candidate account (never root). The account must exist and
# the current/release directories must be readable by it (see next/ops/README.md).
User=thg-next
Group=thg-next
# Placeholder paths — FND-010 fills exact release/symlink paths after human review.
WorkingDirectory=/var/www/thgfulfill-next/current
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node .next/standalone/server.js
# Graceful restart
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=2
# Hardening (candidate; validated by FND-010)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/www/thgfulfill-next

[Install]
WantedBy=multi-user.target
