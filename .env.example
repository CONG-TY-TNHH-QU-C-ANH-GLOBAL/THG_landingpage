# CMS API base URL.
# Local dev (cmsthgfulfill running on port 8080):
VITE_CMS_API_URL=http://localhost:8080/api/v1
# Production:
# VITE_CMS_API_URL=https://cms.thgfulfill.com/api/v1

# Catalog API (legacy public catalog service).
# Default origin: hub.thgfulfill.com (dev.thgfulfill.com retired 2026-05-09).
# Override only if you run a local clone of the catalog backend.
VITE_CATALOG_API_URL=https://hub.thgfulfill.com/api/public/catalog

# ─── Analytics & tracking (consent-gated by ConsentBanner) ───
# Audit P0.5: leave blank in dev to skip injection. Fill prod values to fire after user accepts cookies.
VITE_GA4_ID=
VITE_GTM_ID=
VITE_FB_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=
VITE_SENTRY_DSN=

# ─── Cloudflare Turnstile (lead form anti-spam) ───
# Public site key — paired with TURNSTILE_SECRET on cmsthgfulfill side.
# Leave empty in dev: LeadFormDialog sends DEV_BYPASS token which CMS accepts only when missing key.
VITE_TURNSTILE_SITE_KEY=

# ─── Optional tracking lookup endpoint ───
# GET endpoint consumed by /:lang/tracking, queried as: <url>?id=<order_id>
VITE_TRACKING_LOOKUP_URL=
